APP_NAME=India Candle AI
DEFAULT_INTERVAL=60m
TRAIN_DAYS=90
MIN_TRAIN_ROWS=240
SIGNAL_PRECISION_GATE=0.90
MAX_CACHE_HOURS=12
DATA_TIMEOUT_SECONDS=12
MAX_CANDLES_DISPLAY=140
MONITORED_REPOSITORY=workspace/monitored_repository

# Live market data is the default. Enable only for an explicit offline test harness.
ALLOW_FALLBACK=false
CATALOG_REFRESH_HOURS=12
DEEP_SECURITY_SCAN=false

# Optional production-direction switch.
AUTH_ENABLED=false
AUTH_USERNAME=judge
AUTH_PASSWORD=change-me

# Optional future GitHub webhook verification.
GITHUB_WEBHOOK_SECRET=
